{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local foundation only. No real Cloudflare database is configured yet.
  "name": "sumaryjapanese-local",
  "main": "backend/cloudflare/worker.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "local",
    "FRONTEND_URL": "http://127.0.0.1:8787",
    "JWT_SECRET": "local-only-auth-key-never-use-in-production-2026",
    "QUIZ_REVISION_SECRET": "local-only-quiz-revision-key-not-for-production"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sumaryjapanese-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "backend/cloudflare/migrations"
  }]
}
