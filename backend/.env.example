# Environment
NODE_ENV=development
PORT=3001

# JWT
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sumaryjp_figma

# Frontend
FRONTEND_URL=http://localhost:5173

# lax for same-site frontend/API domains. none only for HTTPS cross-site hosting.
REFRESH_COOKIE_SAME_SITE=lax

# Number of trusted reverse proxies in front of Express (0 when running directly)
TRUST_PROXY=0

# Required only when running prisma seed
SEED_ADMIN_EMAIL=admin@sumaryjp.com
SEED_ADMIN_PASSWORD=replace_with_a_unique_12_plus_character_password
