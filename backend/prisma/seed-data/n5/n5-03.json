  "grammar": [
    {
      "sourceRef": "N5-03.grammar.001",
      "pattern": "今 ～時 ～分 です",
      "meaningVn": "Bây giờ là ~ giờ ~ phút",
      "meaningEn": "It is ~ o'clock ~ minute(s) now",
      "explanation": "Dùng để nói giờ hiện tại. 今 (ima) nghĩa là bây giờ.",
      "introducedIn": "N5-03",
      "examples": [
        {
          "japanese": "今は９時半です。",
          "romaji": "Ima wa kuji han desu.",
          "english": "It is 9:30 now.",
          "vietnamese": "Bây giờ là 9 rưỡi."
        }
      ]
    },
    {
      "sourceRef": "N5-03.grammar.002",
      "pattern": "N1 から N2 まで",
      "meaningVn": "Từ N1 đến N2",
      "meaningEn": "From N1 to N2",
      "explanation": "から nghĩa là 'từ', まで nghĩa là 'đến'. Dùng để biểu thị khoảng thời gian hoặc không gian.",
      "introducedIn": "N5-03",
      "examples": [
        {
          "japanese": "会議は９時から５時までです。",
          "romaji": "Kaigi wa kuji kara goji made desu.",
          "english": "The meeting is from 9 to 5.",
          "vietnamese": "Cuộc họp từ 9 giờ đến 5 giờ."
        }
      ]
    },
    {
      "sourceRef": "N5-03.grammar.003",
      "pattern": "N (thời gian) に",
      "meaningVn": "Vào lúc (thời gian)",
      "meaningEn": "At (time)",
      "explanation": "Trợ từ に dùng sau danh từ chỉ thời gian có con số cụ thể để chỉ thời điểm một hành động hoặc sự kiện xảy ra.",
      "introducedIn": "N5-03",
      "examples": [
        {
          "japanese": "会議は９時に始まります。",
          "romaji": "Kaigi wa kuji ni hajimarimasu.",
          "english": "The meeting starts at 9 o'clock.",
          "vietnamese": "Cuộc họp bắt đầu lúc 9 giờ."
        }
      ]
    },
    {
      "sourceRef": "N5-03.grammar.004",
      "pattern": "N1 と N2",
      "meaningVn": "N1 và N2",
      "meaningEn": "N1 and N2",
      "explanation": "Trợ từ と dùng để nối hai danh từ với nhau, mang nghĩa là 'và'.",
      "introducedIn": "N5-03",
      "examples": [
        {
          "japanese": "休みは土曜日と日曜日です。",
          "romaji": "Yasumi wa doyoubi to nichiyoubi desu.",
          "english": "The days off are Saturday and Sunday.",
          "vietnamese": "Ngày nghỉ là thứ Bảy và Chủ Nhật."
        }
      ]
    },
    {
      "sourceRef": "N5-03.grammar.005",
      "pattern": "いつ",
      "meaningVn": "Khi nào",
      "meaningEn": "When",
      "explanation": "いつ là từ để hỏi thời gian nói chung (Khi nào). Không dùng trợ từ に sau いつ.",
      "introducedIn": "N5-03",
      "examples": [
        {
          "japanese": "試験はいつですか。",
          "romaji": "Shiken wa itsu desu ka.",
          "english": "When is the exam?",
          "vietnamese": "Kỳ thi là khi nào?"
        }
      ]
    }
  ],
