  "grammar": [
    {
      "sourceRef": "N5-08.grammar.001",
      "pattern": "Vたいです",
      "meaningVn": "Muốn làm V",
      "meaningEn": "Want to do V",
      "explanation": "Thể hiện mong muốn thực hiện một hành động của người nói. Động từ bỏ ます + たいです.",
      "introducedIn": "N5-08",
      "examples": [
        {
          "japanese": "映画を見たいです。",
          "romaji": "Eiga o mitai desu.",
          "english": "I want to watch a movie.",
          "vietnamese": "Tôi muốn xem phim."
        },
        {
          "japanese": "日本へ行きたいです。",
          "romaji": "Nihon e ikitai desu.",
          "english": "I want to go to Japan.",
          "vietnamese": "Tôi muốn đi Nhật."
        }
      ]
    },
    {
      "sourceRef": "N5-08.grammar.002",
      "pattern": "Vませんか",
      "meaningVn": "Cùng làm V nhé? / Bạn có muốn V không?",
      "meaningEn": "Won't you do V?",
      "explanation": "Dùng để rủ rê, mời mọc người khác cùng làm gì đó. Thường đi kèm với いっしょに (cùng nhau).",
      "introducedIn": "N5-08",
      "examples": [
        {
          "japanese": "いっしょに映画を見ませんか。",
          "romaji": "Isshoni eiga o mimasen ka.",
          "english": "Won't you watch a movie with me?",
          "vietnamese": "Cùng xem phim với tôi không?"
        },
        {
          "japanese": "いいですね。見ましょう。",
          "romaji": "Ii desu ne. Mimashou.",
          "english": "That's good. Let's watch.",
          "vietnamese": "Hay đấy. Cùng xem đi."
        }
      ]
    },
    {
      "sourceRef": "N5-08.grammar.003",
      "pattern": "N(địa điểm) へ V(bỏ ます) に 行きます",
      "meaningVn": "Đi đến N để làm V",
      "meaningEn": "Go to N to do V",
      "explanation": "Chỉ mục đích của sự di chuyển. Động từ bỏ ます, thêm に hành động như một mục đích.",
      "introducedIn": "N5-08",
      "examples": [
        {
          "japanese": "図書館へ本を借りに行きます。",
          "romaji": "Toshokan e hon o kari ni ikimasu.",
          "english": "I go to the library to borrow books.",
          "vietnamese": "Tôi đi đến thư viện để mượn sách."
        },
        {
          "japanese": "プールへ泳ぎに行きます。",
          "romaji": "Puuru e oyogi ni ikimasu.",
          "english": "I go to the pool to swim.",
          "vietnamese": "Tôi đi bơi ở hồ bơi."
        }
      ]
    },
    {
      "sourceRef": "N5-08.grammar.004",
      "pattern": "どうしてですか",
      "meaningVn": "Tại sao vậy?",
      "meaningEn": "Why?",
      "explanation": "Từ để hỏi lý do.",
      "introducedIn": "N5-08",
      "examples": [
        {
          "japanese": "A: 明日は行きません。\nB: どうしてですか。",
          "romaji": "A: Ashita wa ikimasen. B: Doushite desu ka.",
          "english": "A: I won't go tomorrow. B: Why?",
          "vietnamese": "A: Ngày mai tôi không đi. B: Tại sao vậy?"
        }
      ]
    },
    {
      "sourceRef": "N5-08.grammar.005",
      "pattern": "〜からです",
      "meaningVn": "Bởi vì ~",
      "meaningEn": "Because ~",
      "explanation": "Từ chỉ lý do, đặt ở cuối câu để trả lời cho câu hỏi どうして (Tại sao).",
      "introducedIn": "N5-08",
      "examples": [
        {
          "japanese": "用事があるからです。",
          "romaji": "Youji ga aru kara desu.",
          "english": "Because I have errands.",
          "vietnamese": "Vì tôi có việc bận."
        },
        {
          "japanese": "忙しいからです。",
          "romaji": "Isogashii kara desu.",
          "english": "Because I am busy.",
          "vietnamese": "Vì tôi bận."
        }
      ]
    }
  ],
  "conversations": [
    {
      "sourceRef": "N5-08.kaiwa.001",
      "title": "Inviting a friend",
      "titleJp": "映画を見ませんか",
      "situation": "Inviting a friend to a movie on the weekend",
      "lines": [
        {
          "speaker": "田中",
          "japanese": "今週の週末、いっしょに映画を見ませんか。",
          "hiragana": "こんしゅうのしゅうまつ、いっしょにえいがをみませんか。",
          "romaji": "Konshuu no shuumatsu, isshoni eiga o mimasen ka.",
          "translation": "Would you like to watch a movie together this weekend?",
          "sortOrder": 1
        },
        {
          "speaker": "山田",
          "japanese": "いいですね。何を見ますか。",
          "hiragana": "いいですね。なにをみますか。",
          "romaji": "Ii desu ne. Nani o mimasu ka.",
          "translation": "That sounds good. What will we watch?",
          "sortOrder": 2
        },
        {
          "speaker": "田中",
          "japanese": "新しい映画です。とても面白いですよ。",
          "hiragana": "あたらしいえいがです。とてもおもしろいですよ。",
          "romaji": "Atarashii eiga desu. Totemo omoshiroi desu yo.",
          "translation": "A new movie. It's very interesting.",
          "sortOrder": 3
        },
        {
          "speaker": "山田",
          "japanese": "はい、ぜひ行きたいです。",
          "hiragana": "はい、ぜひいきたいです。",
          "romaji": "Hai, zehi ikitai desu.",
          "translation": "Yes, I definitely want to go.",
          "sortOrder": 4
        }
      ]
    },
    {
      "sourceRef": "N5-08.kaiwa.002",
      "title": "Declining an invitation",
      "titleJp": "用事がありますから",
      "situation": "Declining an invitation politely due to other plans",
      "lines": [
        {
          "speaker": "田中",
          "japanese": "日曜日、いっしょに海へ泳ぎに行きませんか。",
          "hiragana": "にちようび、いっしょにうみへおよぎにいきませんか。",
          "romaji": "Nichiyoubi, isshoni umi e oyogi ni ikimasen ka.",
          "translation": "Won't you go swimming in the sea with me on Sunday?",
          "sortOrder": 1
        },
        {
          "speaker": "鈴木",
          "japanese": "日曜日はちょっと…。約束がありますから。",
          "hiragana": "にちようびはちょっと…。やくそくがありますから。",
          "romaji": "Nichiyoubi wa chotto... Yakusoku ga arimasu kara.",
          "translation": "Sunday is a bit (inconvenient)... Because I have an appointment.",
          "sortOrder": 2
        },
        {
          "speaker": "田中",
          "japanese": "そうですか。残念ですね。",
          "hiragana": "そうですか。ざんねんですね。",
          "romaji": "Sou desu ka. Zannen desu ne.",
          "translation": "I see. That's a shame.",
          "sortOrder": 3
        },
        {
          "speaker": "鈴木",
          "japanese": "すみません。また今度お願いします。",
          "hiragana": "すみません。またこんどおねがいします。",
          "romaji": "Sumimasen. Mata kondo onegaishimasu.",
          "translation": "I'm sorry. Please invite me again next time.",
          "sortOrder": 4
        }
      ]
    }
  ],
