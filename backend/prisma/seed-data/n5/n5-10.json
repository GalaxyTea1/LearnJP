  "grammar": [
    {
      "sourceRef": "N5-10.grammar.001",
      "pattern": "Cách chia động từ thể て (Te-form)",
      "meaningVn": "Thể て",
      "meaningEn": "Te-form of verbs",
      "explanation": "Nhóm 1: い/ち/り -> って; み/び/に -> んで; き -> いて; ぎ -> いで; し -> して. (Ngoại lệ: 行きます -> 行って). Nhóm 2: Bỏ ます + て. Nhóm 3: します -> して; 来ます -> 来て.",
      "introducedIn": "N5-10",
      "examples": [
        {
          "japanese": "待ちます -> 待って",
          "romaji": "machimasu -> matte",
          "english": "wait -> wait (te-form)",
          "vietnamese": "đợi -> đợi (thể te)"
        },
        {
          "japanese": "食べます -> 食べて",
          "romaji": "tabemasu -> tabete",
          "english": "eat -> eat (te-form)",
          "vietnamese": "ăn -> ăn (thể te)"
        }
      ]
    },
