          "vietnamese": "Xin hãy viết tên của bạn."
        }
      ]
    },
    {
      "sourceRef": "N5-10.grammar.003",
      "pattern": "Vています",
      "meaningVn": "Đang làm V / (Trạng thái)",
      "meaningEn": "Is doing V / (State)",
      "explanation": "Biểu thị hành động đang diễn ra tại thời điểm nói, hoặc một trạng thái/thói quen kéo dài đến hiện tại (như kết hôn, sống ở đâu, biết ai đó).",
      "introducedIn": "N5-10",
      "examples": [
        {
