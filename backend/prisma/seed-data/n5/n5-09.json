  "grammar": [
    {
      "sourceRef": "N5-09.grammar.001",
      "pattern": "Tính từ đuôi い: ～かったです / ～くなかったです",
      "meaningVn": "Đã ~, đã không ~",
      "meaningEn": "Past tense of i-adjectives",
      "explanation": "Dùng để diễn tả trạng thái trong quá khứ. Quá khứ: bỏ い thêm かったです. Phủ định quá khứ: bỏ い thêm くなかったです (hoặc くありませんでした).",
      "introducedIn": "N5-09",
      "examples": [
        {
          "japanese": "昨日は寒かったです。",
          "romaji": "Kinou wa samukatta desu.",
          "english": "It was cold yesterday.",
          "vietnamese": "Hôm qua trời đã lạnh."
        },
        {
          "japanese": "テストは難しくなかったです。",
          "romaji": "Tesuto wa muzukashikunakatta desu.",
          "english": "The test wasn't difficult.",
          "vietnamese": "Bài kiểm tra đã không khó."
        }
      ]
    },
    {
      "sourceRef": "N5-09.grammar.002",
      "pattern": "Tính từ đuôi な / Danh từ: ～でした / ～じゃありませんでした",
      "meaningVn": "Đã là ~, đã không là ~",
      "meaningEn": "Past tense of na-adj / Nouns",
      "explanation": "Quá khứ của tính từ đuôi な (bỏ な) và danh từ giống nhau: Khẳng định dùng でした, phủ định dùng じゃありませんでした.",
      "introducedIn": "N5-09",
      "examples": [
        {
          "japanese": "旅行は静かでした。",
          "romaji": "Ryokou wa shizuka deshita.",
          "english": "The trip was quiet.",
          "vietnamese": "Chuyến du lịch đã rất yên tĩnh."
        },
        {
          "japanese": "昨日は雨じゃありませんでした。",
          "romaji": "Kinou wa ame ja arimasen deshita.",
          "english": "It was not rain yesterday.",
          "vietnamese": "Hôm qua đã không mưa."
        }
      ]
    },
    {
      "sourceRef": "N5-09.grammar.003",
      "pattern": "A は B より ～です",
      "meaningVn": "A thì ~ hơn B",
      "meaningEn": "A is more ~ than B",
      "explanation": "Cấu trúc so sánh hơn giữa 2 sự vật. 'より' mang nghĩa 'hơn so với'.",
      "introducedIn": "N5-09",
      "examples": [
        {
          "japanese": "今日は昨日より暑いです。",
          "romaji": "Kyou wa kinou yori atsui desu.",
          "english": "Today is hotter than yesterday.",
          "vietnamese": "Hôm nay nóng hơn hôm qua."
        },
        {
          "japanese": "飛行機は車より速いです。",
          "romaji": "Hikouki wa kuruma yori hayai desu.",
          "english": "Airplanes are faster than cars.",
          "vietnamese": "Máy bay thì nhanh hơn ô tô."
        }
      ]
    },
    {
      "sourceRef": "N5-09.grammar.004",
      "pattern": "A と B と どちらが ～ですか / A のほうが ～です",
      "meaningVn": "A và B, cái nào ~ hơn? / A thì ~ hơn",
      "meaningEn": "Which is more ~, A or B? / A is more ~",
      "explanation": "Dùng để hỏi khi lựa chọn giữa 2 vật. 'どちら' là cái nào/người nào. Trả lời dùng '～のほうが'.",
      "introducedIn": "N5-09",
      "examples": [
        {
          "japanese": "春と秋とどちらが好きですか。",
          "romaji": "Haru to aki to dochira ga suki desu ka.",
          "english": "Between spring and autumn, which do you like?",
          "vietnamese": "Giữa mùa xuân và mùa thu, bạn thích mùa nào hơn?"
        },
        {
          "japanese": "秋のほうが好きです。",
          "romaji": "Aki no hou ga suki desu.",
          "english": "I like autumn more.",
          "vietnamese": "Tôi thích mùa thu hơn."
        }
      ]
    },
    {
      "sourceRef": "N5-09.grammar.005",
      "pattern": "Group の中で N が 一番 ～です",
      "meaningVn": "Trong (tập hợp), N là ~ nhất",
