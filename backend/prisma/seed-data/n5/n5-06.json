  "grammar": [
    {
      "sourceRef": "N5-06.grammar.001",
      "pattern": "N を ください",
      "meaningVn": "Làm ơn cho tôi N",
      "meaningEn": "Please give me N",
      "explanation": "Dùng để yêu cầu người khác lấy/cho mình cái gì đó, thường dùng khi gọi món ở nhà hàng hoặc mua đồ.",
      "introducedIn": "N5-06",
      "examples": [
        {
          "japanese": "メニューをください。",
          "romaji": "Menyuu o kudasai.",
          "english": "Please give me the menu.",
          "vietnamese": "Làm ơn cho tôi xin thực đơn."
        },
        {
          "japanese": "水をください。",
          "romaji": "Mizu o kudasai.",
          "english": "Water, please.",
          "vietnamese": "Làm ơn cho xin nước."
        }
      ]
    },
    {
      "sourceRef": "N5-06.grammar.002",
      "pattern": "N が 好き / 嫌い です",
      "meaningVn": "Thích / Ghét N",
      "meaningEn": "Like / Dislike N",
      "explanation": "好き (thích) và 嫌い (ghét) là tính từ đuôi な. Đối tượng được thích/ghét đi với trợ từ が.",
      "introducedIn": "N5-06",
      "examples": [
        {
          "japanese": "私は寿司が好きです。",
          "romaji": "Watashi wa sushi ga suki desu.",
          "english": "I like sushi.",
          "vietnamese": "Tôi thích sushi."
        },
        {
          "japanese": "野菜が嫌いです。",
          "romaji": "Yasai ga kirai desu.",
          "english": "I dislike vegetables.",
          "vietnamese": "Tôi ghét rau."
        }
      ]
    },
    {
      "sourceRef": "N5-06.grammar.003",
      "pattern": "Vましょう / Vましょうか",
      "meaningVn": "Hãy cùng làm V / Cùng làm V nhé?",
      "meaningEn": "Let's do V / Shall we do V?",
      "explanation": "Dùng để rủ rê, đề nghị người nghe cùng làm một việc gì đó. ましょうか mang tính chất hỏi ý kiến.",
      "introducedIn": "N5-06",
      "examples": [
        {
          "japanese": "昼ごはんを食べましょう。",
          "romaji": "Hirugohan o tabemashou.",
          "english": "Let's eat lunch.",
          "vietnamese": "Cùng ăn trưa nào."
        },
        {
          "japanese": "コーヒーを飲みましょうか。",
          "romaji": "Koohii o nomimashou ka.",
          "english": "Shall we drink coffee?",
          "vietnamese": "Cùng uống cà phê nhé?"
        }
      ]
    },
    {
      "sourceRef": "N5-06.grammar.004",
      "pattern": "どんな N",
      "meaningVn": "N như thế nào / Loại N nào",
      "meaningEn": "What kind of N",
      "explanation": "Dùng để hỏi về tính chất, trạng thái hoặc loại của một danh từ.",
      "introducedIn": "N5-06",
      "examples": [
        {
          "japanese": "どんな食べ物が好きですか。",
          "romaji": "Donna tabemono ga suki desu ka.",
          "english": "What kind of food do you like?",
          "vietnamese": "Bạn thích loại đồ ăn nào?"
        }
      ]
    },
    {
      "sourceRef": "N5-06.grammar.005",
      "pattern": "N は Tính từ です",
      "meaningVn": "N thì (tính từ)",
      "meaningEn": "N is (adjective)",
      "explanation": "Dùng tính từ để miêu tả vị giác (ngon, dở, ngọt, cay...) của đồ ăn thức uống.",
      "introducedIn": "N5-06",
      "examples": [
