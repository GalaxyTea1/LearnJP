          "vietnamese": "Tôi muốn có một đôi giày mới."
        },
        {
          "japanese": "お金がほしいです。",
          "romaji": "Okane ga hoshii desu.",
          "english": "I want money.",
          "vietnamese": "Tôi muốn có tiền."
        }
      ]
    },
