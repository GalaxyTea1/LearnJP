      ]
    },
    {
      "sourceRef": "N5-07.grammar.002",
      "pattern": "N が ほしいです",
      "meaningVn": "Muốn có N",
      "meaningEn": "Want N",
      "explanation": "ほしい là tính từ đuôi い, biểu thị mong muốn sở hữu một vật nào đó. Trợ từ đi kèm là が.",
