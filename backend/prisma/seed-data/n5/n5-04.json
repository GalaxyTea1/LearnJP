  "grammar": [
    {
      "sourceRef": "N5-04.grammar.001",
      "pattern": "Vます / Vません",
      "meaningVn": "Làm / Không làm",
      "meaningEn": "Do / Do not do",
      "explanation": "Vます dùng để nói thói quen hiện tại hoặc việc sẽ làm tương lai. Vません là dạng phủ định.",
      "introducedIn": "N5-04",
      "examples": [
        {
          "japanese": "私はパンを食べます。",
          "romaji": "Watashi wa pan o tabemasu.",
          "english": "I eat bread.",
          "vietnamese": "Tôi ăn bánh mì."
        },
        {
          "japanese": "お酒を飲みません。",
          "romaji": "Osake o nomimasen.",
          "english": "I do not drink alcohol.",
          "vietnamese": "Tôi không uống rượu."
        }
      ]
    },
    {
      "sourceRef": "N5-04.grammar.002",
      "pattern": "N(Object) を Vます",
      "meaningVn": "Làm tác động lên N (Tân ngữ)",
      "meaningEn": "Direct object marker",
      "explanation": "Trợ từ を (o) đứng sau tân ngữ trực tiếp chịu tác động của động từ.",
      "introducedIn": "N5-04",
      "examples": [
        {
          "japanese": "本を読みます。",
          "romaji": "Hon o yomimasu.",
          "english": "I read a book.",
          "vietnamese": "Tôi đọc sách."
        },
        {
          "japanese": "写真を撮ります。",
          "romaji": "Shashin o torimasu.",
          "english": "I take a photo.",
          "vietnamese": "Tôi chụp ảnh."
        }
      ]
    },
    {
      "sourceRef": "N5-04.grammar.003",
      "pattern": "N(Place) で Vます",
      "meaningVn": "Làm V ở / tại N",
      "meaningEn": "Action at Place",
      "explanation": "Trợ từ で (de) đứng sau danh từ chỉ địa điểm để diễn tả nơi xảy ra hành động.",
      "introducedIn": "N5-04",
      "examples": [
        {
          "japanese": "うちでご飯を食べます。",
          "romaji": "Uchi de gohan o tabemasu.",
          "english": "I eat a meal at home.",
          "vietnamese": "Tôi ăn cơm ở nhà."
        },
        {
          "japanese": "スーパーで買います。",
          "romaji": "Suupaa de kaimasu.",
          "english": "I buy it at the supermarket.",
          "vietnamese": "Tôi mua ở siêu thị."
        }
      ]
    },
    {
      "sourceRef": "N5-04.grammar.004",
      "pattern": "何をしますか",
      "meaningVn": "Bạn làm gì?",
      "meaningEn": "What do you do?",
      "explanation": "何 (nani) nghĩa là 'cái gì', kết hợp với をしますか dùng để hỏi ai đó làm việc gì.",
      "introducedIn": "N5-04",
      "examples": [
        {
          "japanese": "明日、何をしますか。",
          "romaji": "Ashita, nani o shimasu ka.",
          "english": "What will you do tomorrow?",
          "vietnamese": "Ngày mai, bạn làm gì?"
        },
        {
          "japanese": "公園で何をしますか。",
          "romaji": "Kouen de nani o shimasu ka.",
          "english": "What do you do at the park?",
          "vietnamese": "Bạn làm gì ở công viên?"
        }
      ]
    },
    {
      "sourceRef": "N5-04.grammar.005",
      "pattern": "Trạng từ tần suất (いつも, よく, あまり...)",
      "meaningVn": "Mức độ thường xuyên",
      "meaningEn": "Frequency adverbs",
      "explanation": "いつも (luôn luôn), よく (thường xuyên), ときどき (thỉnh thoảng) đi với Vます. あまり (không lắm), ぜんぜん (hoàn toàn không) phải đi với Vません.",
      "introducedIn": "N5-04",
      "examples": [
        {
          "japanese": "よく映画を見ます。",
          "romaji": "Yoku eiga o mimasu.",
          "english": "I often watch movies.",
          "vietnamese": "Tôi thường xem phim."
        },
        {
          "japanese": "あまりお茶を飲みません。",
          "romaji": "Amari ocha o nomimasen.",
          "english": "I do not drink tea very often.",
          "vietnamese": "Tôi không uống trà lắm."
        }
      ]
    }
  ],
