  "grammar": [
    {
      "sourceRef": "N5-05.grammar.001",
      "pattern": "N が あります / います",
      "meaningVn": "Có N",
      "meaningEn": "There is N / N exists",
      "explanation": "Dùng để biểu thị sự tồn tại. あります dùng cho đồ vật, cây cối (vô tri). います dùng cho người, động vật (có sinh mệnh).",
      "introducedIn": "N5-05",
      "examples": [
        {
          "japanese": "机があります。",
          "romaji": "Tsukue ga arimasu.",
          "english": "There is a desk.",
          "vietnamese": "Có cái bàn."
        },
        {
          "japanese": "犬がいます。",
          "romaji": "Inu ga imasu.",
          "english": "There is a dog.",
          "vietnamese": "Có con chó."
        }
      ]
    },
    {
      "sourceRef": "N5-05.grammar.002",
      "pattern": "N1(place) に N2 が あります / います",
      "meaningVn": "Ở N1 có N2",
      "meaningEn": "N2 is at/in N1",
      "explanation": "Trợ từ に đi sau danh từ chỉ địa điểm để chỉ nơi tồn tại của người hoặc vật N2.",
      "introducedIn": "N5-05",
      "examples": [
        {
          "japanese": "部屋にテレビがあります。",
          "romaji": "Heya ni terebi ga arimasu.",
          "english": "There is a TV in the room.",
          "vietnamese": "Trong phòng có tivi."
        },
        {
          "japanese": "庭に犬がいます。",
          "romaji": "Niwa ni inu ga imasu.",
          "english": "There is a dog in the garden.",
          "vietnamese": "Ngoài vườn có con chó."
        }
      ]
    },
    {
      "sourceRef": "N5-05.grammar.003",
      "pattern": "N2 は N1(place) に あります / います",
      "meaningVn": "N2 ở / có ở N1",
      "meaningEn": "N2 is located at N1",
      "explanation": "Đưa vật hoặc người N2 lên làm chủ đề của câu (bằng trợ từ は), dùng để nói vật/người đó đang ở đâu.",
      "introducedIn": "N5-05",
      "examples": [
        {
          "japanese": "田中さんは事務所にいます。",
          "romaji": "Tanaka-san wa jimusho ni imasu.",
          "english": "Mr. Tanaka is in the office.",
          "vietnamese": "Anh Tanaka ở trong văn phòng."
        },
        {
          "japanese": "トイレはあそこにあります。",
          "romaji": "Toire wa asoko ni arimasu.",
          "english": "The toilet is over there.",
          "vietnamese": "Nhà vệ sinh ở đằng kia."
        }
      ]
    },
    {
      "sourceRef": "N5-05.grammar.004",
      "pattern": "N1(vật) の N2(vị trí)",
      "meaningVn": "Vị trí N2 của N1",
      "meaningEn": "Location N2 of N1",
      "explanation": "Các từ chỉ vị trí (trên, dưới, trong, ngoài, trước, sau...) được dùng như một danh từ và nối với danh từ khác bằng の.",
      "introducedIn": "N5-05",
      "examples": [
        {
          "japanese": "机の上",
          "romaji": "Tsukue no ue",
          "english": "On the desk",
          "vietnamese": "Trên bàn"
        },
        {
          "japanese": "机の上に本があります。",
          "romaji": "Tsukue no ue ni hon ga arimasu.",
          "english": "There is a book on the desk.",
          "vietnamese": "Có quyển sách ở trên bàn."
        }
      ]
    },
    {
      "sourceRef": "N5-05.grammar.005",
      "pattern": "N1 や N2 [など]",
      "meaningVn": "N1, N2 (và những thứ khác)",
      "meaningEn": "N1, N2, and so on",
      "explanation": "Dùng trợ từ や để liệt kê một số vật tiêu biểu (không phải liệt kê toàn bộ như と). Có thể thêm など ở cuối.",
      "introducedIn": "N5-05",
      "examples": [
        {
          "japanese": "箱の中に時計やペンがあります。",
          "romaji": "Hako no naka ni tokei ya pen ga arimasu.",
          "english": "There are things like a watch and a pen inside the box.",
