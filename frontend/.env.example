# Development uses the Vite proxy when this is empty.
VITE_API_URL=
# Production build requires the exact HTTPS API origin, for example:
# VITE_API_URL=https://api.example.com
# Cloudflare: run npm run build from the repository root.
# It explicitly selects cloudflare mode and VITE_API_URL=/ (same-origin /api/v1).
